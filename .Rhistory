# https://rpubs.com/JairoAyala/592802
library(tidyverse)
library(gridExtra)
library(tidyverse)
library(gridExtra)
install.packages("gridExtra")
library(gridExtra)
f_mm <- function(x){(x-min(x))/(diff(range(x)))}
f_tbl <- function(tbl){
TP = tbl[2,2]
FN = tbl[2,1]
TN = tbl[1,1]
FP = tbl[1,2]
res = c(
acc = (TP+TN)/sum(tbl),
sen = TP / (TP+FN),
esp = TN / (TN+FP),
rat = FP / (TN+FP)
)
return(res)
}
set.seed(123)
n = 100
df = data.frame(
x = c(
rnorm(n, 10, 5),
rnorm(n, 20, 5)
),
g = gl(2, n, 2*n, c(0,1))
) %>%
mutate(x = f_mm(x))
res_tot = NULL
for (i in seq(0, 1, 0.03)) {
clasif = ifelse(df$x <= i, 0, 1)
clasif_f = factor(clasif, levels = c(0,1))
tbl = table(grupo = df$g, clasif = clasif_f)
res = c(th = i, f_tbl(tbl))
res_tot = bind_rows(res_tot, res)
}
plt1 = ggplot(df)+
aes(x, fill=g)+
geom_density(alpha=0.5)
plt2 = res_tot %>%
arrange(sen) %>%
ggplot()+
aes(rat, sen)+
geom_point()+geom_line()+
geom_abline(slope = 1, intercept = 0)+
xlim(0,1)+ylim(0,1)+
coord_equal()
grid.arrange(plt1, plt2, nrow=1)
res_tot %>%
mutate(j = sen+esp-1,
j2 = abs(sen+esp-1)/sqrt(2)) %>%
arrange(desc(j))
post=function(media_prior_con, posi_d_sin,posi_d_con){
a=0.01
set.seed(2020)
prior_con=c()
for(i in 1:250)
prior_con[i]=runif(1,a,2*(a+sqrt((media_prior_con-a)/3)))
posterior=prior_con*posi_d_con/(prior_con*posi_d_con+(1-prior_con)*posi_d_sin)
return(list(posterior,prior_con))
plot(posterior,prior_con)
}
salida=data.frame(matrix(unlist(post(0.2,0.01,0.99)),
ncol=2,byrow = F))
colSums(salida)
min(salida)
colnames(salida)=c("prior","posterior")
plot(salida[,2],salida[,1],xlab="prior",ylab="posterior")
salida
