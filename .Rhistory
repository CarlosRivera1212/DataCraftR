library(dplyr)
cel_sub_mat = list(
c(1,2), # sel fila izquierda
c(1,2,3), # sel fila central
c(2,3,4), # sel fila central
c(3,4) # sel fila derecha
)
f_sim = function(n = 100){
res_d = NULL
res_t = NULL
mm = NULL
Ms = list()
for(i in seq(n)){
M = table(
fil = sample(seq(2), 130, T),
col = sample(seq(4), 130, T)
)
M = M-1
val = sort(M)
val[8] = val[8]+8
val = c(
sort(val[1:4], decreasing = T),
sort(val[5:8], decreasing = F)
)
M = matrix(val, nrow = 2, byrow = T)
Ms[[i]] = M
mm[i] = max(M) - min(M)
sub_mat = lapply(cel_sub_mat, function(i){
M[,i]
})
val_esp = lapply(sub_mat, function(smi){
ri = rowSums(smi)
ci = colSums(smi)
st = sum(smi)
(ri %*% t(ci)) / st
# kronecker(ri, t(ci))/st
})
col_sel_esp = c(1,2,2,2)
val_esp_fin = mapply(function(mei, csi){
mei[, csi]
}, mei=val_esp, csi=col_sel_esp)
chi_d = sum(((M - val_esp_fin)**2) / val_esp_fin)
chi_t = chisq.test(M)$statistic
res_d[i] = chi_d
res_t[i] = chi_t
}
return(list(
tbl = data.frame(res_t, res_d, mm),
mat = Ms
))
}
sim1 = f_sim(10000)
range(sim1$tbl$mm)
dev.off()
plot(sim1$tbl$res_t/sim1$tbl$res_d, pch=16, cex=.1)
head(sim1$tbl)
sim1$mat[[100]]
chisq.test(sim1$mat[[100]])
f_mm = function(x){ (x - min(x)) / (max(x) - min(x)) }
set.seed(123)
n = 10
sen = f_mm(sort(rexp(n)))
esp = sort(runif(n, 0,1), decreasing = T)
esc1 = data.frame(sen = sen, esp = esp)
esc2 = data.frame(sen = 1-sen, esp = esp)
esc3 = data.frame(sen = sen, esp = 1-esp)
esc4 = data.frame(sen = 1-sen, esp = 1-esp)
with(esc1, plot(1-esp, sen, col=1, asp=1))
with(esc2, points(1-esp, sen, col=2))
with(esc3, points(1-esp, sen, col=3))
with(esc4, points(1-esp, sen, col=4))
abline(0,1)
with(esc4, plot(1-esp, sen, col=1, asp=1))
esc = esc4
f_auc <- function(esc){
x = 1 - esc$esp
y = esc$sen
# plot(x,y, pch=16)
dx1 = diff(x)
dy1 = diff(y)
dx2 = diff(dx1)
dy2 = diff(dy1)
d2m1 = dx1 %*% t(y[-1])
d2m2 = dx2 %*% t(dy2)
des1 = Re(eigen(d2m1)$values[1])>0
des2 = Re(eigen(d2m2)$values[1])>0
# return(c(des1, des2))
r = cor(x,y, method = 'pearson')
r = abs(r)
if(des1 == des2){
auc = 1-(1 - 0.5*r)
}else{
auc = 1 - 0.5*r
}
return(auc)
}
f_auc(esc1)
with(esc1, plot(1-esp, sen, col=1, asp=1))
f_auc(esc2)
with(esc2, points(1-esp, sen, col=2))
f_auc(esc3)
with(esc3, points(1-esp, sen, col=3))
f_auc(esc4)
with(esc4, points(1-esp, sen, col=4))
writexl::write_xlsx(list(
esc1, esc2, esc3, esc4
), 'esc.xlsx')
integrand <- function(x) {-0.064461 + 2.28942*x^2}
integrate(integrand, lower = 0, upper = 1)
plot(c(0,1), c(0,1), asp=1)
curve(-0.064461 + 2.28942*x^2, 0,1, add=T)
abline(0,1)
points(1- esc1$esp, esc1$sen, pch=16)
